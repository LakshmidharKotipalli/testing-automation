{
  "name": "@browserswarm/browser-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed, allowlisted Playwright actions: launcher, locator resolution, domain guard, observers, step executor",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@browserswarm/core": "workspace:*",
    "@browserswarm/policy-engine": "workspace:*",
    "@browserswarm/shared": "workspace:*",
    "@browserswarm/storage": "workspace:*",
    "playwright": "1.56.1"
  }
}
