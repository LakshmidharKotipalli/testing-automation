# BrowserSwarm central configuration. Copy to .env (gitignored) and edit:  cp .env.example .env
# Variables already exported in your shell or CI take precedence over this file.

# ---------------------------------------------------------------------------
# Website under test: every plan, prompt and CLI command without an explicit
# target uses this URL. Changing it requires a fresh preview + approval.
# ---------------------------------------------------------------------------
BROWSERSWARM_TARGET_URL=https://demo.icatusa.org
# Local fixture site instead (pnpm fixture:serve):
# BROWSERSWARM_TARGET_URL=http://127.0.0.1:4173
# Optional, comma separated. Defaults to the host of BROWSERSWARM_TARGET_URL.
# Add any CDN/font hosts the site loads assets from, e.g. demo.icatusa.org,fonts.googleapis.com
BROWSERSWARM_ALLOWED_DOMAINS=

# ---------------------------------------------------------------------------
# LLM credentials (optional; only needed for LLM-assisted features).
# The key is passed only to the OpenCode process, under the variable name in
# BROWSERSWARM_LLM_API_KEY_ENV (e.g. ANTHROPIC_API_KEY, OPENAI_API_KEY).
# It never appears in plans, approval files, artifacts, reports or prompts.
# Leave empty to use OpenCode's own login instead.
# ---------------------------------------------------------------------------
BROWSERSWARM_LLM_API_KEY=
BROWSERSWARM_LLM_API_KEY_ENV=

# ---------------------------------------------------------------------------
# Other settings
# ---------------------------------------------------------------------------
# Use a specific Chromium binary when Playwright's bundled browser is unavailable.
BROWSERSWARM_CHROMIUM_EXECUTABLE=
# Operator name recorded in approval records (defaults to $USER).
BROWSERSWARM_OPERATOR=
# Secret test data referenced from plans with { fromEnv: NAME, secret: true }, for example:
# QA_PASSWORD=
