# BrowserSwarm does not need model API keys: OpenCode manages provider credentials.
# Optional: path to a Chromium executable when the bundled Playwright browser is unavailable.
BROWSERSWARM_CHROMIUM_EXECUTABLE=
# Optional: default artifact root (overridden by --output).
BROWSERSWARM_ARTIFACT_ROOT=./artifacts
# Optional: operator name recorded in approval records.
BROWSERSWARM_OPERATOR=
